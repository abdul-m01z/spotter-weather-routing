# Public Mapbox token for server-side Directions and Geocoding calls.
# Must not have browser URL restrictions. Never use a secret-scoped token here.
MAPBOX_ACCESS_TOKEN=

# Public/read-only token exposed to the browser for Mapbox GL JS.
# You may reuse the token above locally; separate URL-restricted tokens are preferred later.
VITE_MAPBOX_PUBLIC_TOKEN=

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
