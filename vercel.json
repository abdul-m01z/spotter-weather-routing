{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": { "maxDuration": 60, "includeFiles": "backend/**" }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index.py" }]
}
